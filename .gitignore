# ---- Flutter / Dart ----
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
*.g.dart.lock

# ---- Android ----
android/local.properties
android/.gradle/
# 签名文件与密码：绝对不能进仓库
android/key.properties
*.jks
*.keystore
# 注意：android/app/keystore.b64 是**故意提交**的固定签名密钥（base64）。
# 不提交它，每次云端构建就会生成随机 debug 签名，导致装新版必须先卸载，
# 一卸载数据全丢。本项目为私有仓库、个人自用，故把它入库。

# ---- IDE ----
.idea/
*.iml
.vscode/
*.swp

# ---- 系统 ----
.DS_Store
Thumbs.db

# ---- 排查临时产物（GitHub Actions 日志抓取等）----
logs.zip
runs.json
jobs.json
runid.txt
step.txt

# ---- 取证用的临时目录（拉下来的插件源码、CI 日志），只在本地看，不进仓库 ----
logx/

# ---- 构建产物：只留本地，不进仓库 ----
dist/*.apk
dist/*.zip

# 离线语音模型：构建时由 CI 下载到 assets，绝不进仓库（32MB）
android/app/src/main/assets/vosk-model-zh.zip
