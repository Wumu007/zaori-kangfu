# ---- Flutter / Dart ----
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
*.g.dart.lock

# ---- Android ----
android/local.properties
android/.gradle/
# 签名文件与密码：绝对不能进仓库
android/key.properties
*.jks
*.keystore
# 签名密钥绝不入库（仓库已公开）。密钥只存 GitHub Secrets：
# ANDROID_KEYSTORE_BASE64 / ANDROID_STORE_PASSWORD /
# ANDROID_KEY_ALIAS / ANDROID_KEY_PASSWORD。
android/app/*.b64

# ---- IDE ----
.idea/
*.iml
.vscode/
*.swp

# ---- 系统 ----
.DS_Store
Thumbs.db

# ---- 排查临时产物（GitHub Actions 日志抓取等）----
logs.zip
runs.json
jobs.json
runid.txt
step.txt

# ---- 取证用的临时目录（拉下来的插件源码、CI 日志），只在本地看，不进仓库 ----
logx/

# ---- 构建产物：只留本地，不进仓库 ----
dist/*.apk
dist/*.zip

# 离线语音模型：构建时由 CI 下载到 assets，绝不进仓库（32MB）
android/app/src/main/assets/vosk-model-zh.zip
