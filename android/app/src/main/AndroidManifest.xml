<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ======================================================================
         权限：每一条都对应一个真实功能，多一条都不要
         ====================================================================== -->

    <!-- 通知（Android 13+ 必须运行时申请，否则通知静默丢弃） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 精确闹钟：不给的话系统会把提醒推迟几分钟到几十分钟 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Android 13+ 上「日历类 App」可用 USE_EXACT_ALARM 免手动授权；
         早日康复属于时间敏感，可一起声明，Google Play 审核时需说明用途 -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- 手机重启后重新排通知，否则重启一次就再也不响 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 语音录入收音 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- 导出文件写入（Android 10 及以下需要；11+ 走系统「保存到」不再需要，
         但部分 ROM 的文件选择器仍会按旧路径落盘，声明上以兼容） -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- 通知震动 -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 部分机型锁屏亮屏提醒需要 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 闹钟式强提醒：到点全屏弹出提醒界面（锁屏/息屏也生效）。
         Android 14+ 系统会按「闹钟/来电类」自动授予，无需手动开 -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- V1.5.0：申请「忽略电池优化」白名单。
         vivo/小米/OPPO 等会冻结后台应用并取消第三方 App 的闹钟 ——
         这是「前台收得到、后台/被杀收不到」的直接原因。
         白名单通过系统确认框由用户手动允许（设置页有入口），
         Google Play 对闹钟/提醒类 App 允许申请此权限 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- V1.6.0：后台守护前台服务。
         Android 12+ 的前台服务必须有常驻通知；Android 14+ 必须声明
         foregroundServiceType。用药提醒属于「特殊用途」，用 specialUse。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- 语音识别 / TTS 在 Android 11+ 需要显式声明可见性 -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:label="早日康复"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- ==================================================================
             flutter_local_notifications 需要的接收器
             少了 ScheduledNotificationReceiver，zonedSchedule 会「排了不响」
             ================================================================== -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"
            android:exported="false" />

        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- 通知上的「已服用 / 延后」按钮 -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver"
            android:exported="false" />

        <!-- ==================================================================
             第二通道的接收器（V1.7.0）
             用户日志证明插件排的那批 alarm 会被系统拦掉，这里用自建
             AlarmManager + 静态注册 receiver 再走一条独立通道。
             静态注册的意义：进程被 ROM 清掉后，系统仍能拉起它发通知。
             ================================================================== -->
        <receiver
            android:name=".GuardAlarmReceiver"
            android:exported="false" />

        <!-- ==================================================================
             后台守护前台服务（V1.6.0）
             「只在 App 界面里能提醒」的直接解法：前台服务优先级等同前台
             App，系统不会轻易冻结，App 排的闹钟才不会被一并清掉。
             ================================================================== -->
        <service
            android:name=".ReminderGuardService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="medication reminder reliability" />
        </service>
    </application>
</manifest>
